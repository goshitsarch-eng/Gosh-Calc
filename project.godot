; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.

config_version=5

[application]

config/name="Gosh Calc"
config/description="A standard, scientific and programmer calculator."
config/version="0.3.0-alpha.1"
run/main_scene="res://scenes/main.tscn"
run/low_processor_mode=true
config/features=PackedStringArray("4.7", "GL Compatibility")
boot_splash/show_image=false
boot_splash/bg_color=Color(0.0941176, 0.105882, 0.12549, 1)
config/icon="res://assets/icon.png"

[audio]

driver/driver="Dummy"

[display]

window/size/viewport_width=460
window/size/viewport_height=700
window/dpi/allow_hidpi=true

[input_devices]

pointing/emulate_touch_from_mouse=false

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
